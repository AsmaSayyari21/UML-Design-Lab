sequenceDiagram
    autonumber
    actor U as User
    participant M as Menu
    participant O as Order
    participant P as Payment
    participant R as Restaurant

    %% Step 1: Browse Menu
    U->>M: view()
    M-->>U: Return items & availability

    %% Step 2: Build Order / Cart
    loop Add/Remove Items
        U->>U: addItem() / removeItem()
    end

    %% Step 3: Place Order
    U->>O: placeOrder()
    activate O
    O->>R: send / receiveorder()
    activate R
    R-->>O: Order accepted
    O-->>U: Order initialized (Status: Pending)

    %% Step 4: Payment Processing
    U->>P: makePayment()
    activate P
    P->>P: processPayment()
    alt Payment Successful
        P-->>O: Payment status: Success
        O->>O: updatestatus(Paid)
        O-->>U: Payment Confirmation
    else Payment Failed
        P-->>O: Payment status: Failed
        O->>O: updatestatus(Cancelled)
        O-->>U: Payment Failed Notification
    end
    deactivate P

    %% Step 5: Food Preparation & Dispatch
    R->>R: preparefood()
    R->>O: updatestatus(Preparing)
    O-->>U: notifies(Food Being Prepared)

    R->>R: dispatchorder()
    R->>O: updatestatus(Dispatched)
    O-->>U: notifies(Order Out for Delivery)
    deactivate R
    deactivate O