sequenceDiagram
    autonumber
    actor U as User
    participant M as Menu
    participant O as Order
    participant R as Restaurant

    %% Step 1: Browse Menu
    U->>M: view()
    M-->>U: Return items & availability

    %% Step 2: Build Order / Cart
    loop Add/Remove Items
        U->>U: addItem() / removeItem()
    end

    %% Step 3: Place Order
    U->>O: placeOrder()
    activate O
    O->>R: send / receiveorder()
    activate R
    R-->>O: Order accepted
    O->>O: updatestatus(Accepted)
    O-->>U: Order confirmation (Status: Accepted)

    %% Step 4: Food Preparation
    R->>R: preparefood()
    R->>O: updatestatus(Preparing)
    O-->>U: notifies(Food Being Prepared)

    %% Step 5: Order Ready / Completion
    R->>O: updatestatus(Ready)
    O-->>U: notifies(Order Ready)
    deactivate R
    deactivate O